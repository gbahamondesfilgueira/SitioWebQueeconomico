<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the hosting document root points to the project root, keep private
    # Laravel files outside direct web access and forward traffic to /public.
    RewriteRule ^(\.env|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|docs|lang|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
